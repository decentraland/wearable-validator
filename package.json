{
  "name": "wearable-validator-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "npm run dev -w wearable-validator-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "catalyst": "npm run catalyst -w wearable-validator-tools --",
    "samples": "npm run samples -w wearable-validator-tools",
    "serve": "npm run build -w wearable-validator-web && npm start -w wearable-validator-server --",
    "review": "npm run review -w wearable-validator-server --"
  },
  "devDependencies": {
    "wrangler": "4.143.1"
  }
}
