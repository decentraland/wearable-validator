{
  "name": "wearable-validator-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "packages/*",
    "tools"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "catalyst": "npm run catalyst -w wearable-validator-tools --",
    "job": "npm run job -w wearable-validator-job",
    "poc": "npm run poc -w wearable-validator-job --"
  }
}
