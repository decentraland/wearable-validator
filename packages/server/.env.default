# Defaults for the run server (packages/server). Committed; holds no secrets. The process environment wins over
# every line here, and the legacy names PORT / HOST (the Dockerfile) are accepted for the two below.

# Bind address. Anything but loopback needs Cloudflare Access (CF_ACCESS_*) or INSECURE_ANONYMOUS=1.
HTTP_SERVER_PORT=4180
HTTP_SERVER_HOST=127.0.0.1

# Hostnames a public deployment answers on (comma-separated); other Host headers get 403. Loopback names always pass.
# PUBLIC_HOSTS=validator.example.org

# Cloudflare Access: the team slug and the application's audience tag. Set both or neither.
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# Shared secret (32+ characters) the Slack bot sends as a Bearer token; a secret, never written here.
# OPERATOR_TOKEN=
# 1 makes every caller owner "anonymous" on a non-loopback host: local Docker smoke tests only.
# INSECURE_ANONYMOUS=0

# The model credential: a `claude setup-token` (sk-ant-oat…); a secret, never written here. Unset = dry run, no model call.
# ANTHROPIC_OAUTH_SETUP_TOKEN=

# One Slack message per finished run (thumbnail, verdict, curator needed?, Open run button). Unset = no notifications.
# The app's Bot User OAuth Token (xoxb-…, scopes chat:write + files:write); a secret, never written here.
# SLACK_BOT_TOKEN=
# The channel id (C…/G…) the app was invited to; required with the token.
# SLACK_CHANNEL=
# The public site the Open run button points at (no trailing slash); unset makes the link relative and logs a warning.
# SITE_URL=https://wearable-validator.dclregenesislabs.xyz

# Unity build of unity-explorer PR #10053; defaults to packages/server/renderer-build when its wasm is there.
# RENDERER_BUILD=
# Extra Chromium flags; the Docker image sets the Vulkan/SwiftShader/dev-shm ones.
# CHROMIUM_ARGS=
# Chromium's own sandbox around creator models. It needs user namespaces (in Docker, Playwright's seccomp profile);
# 0 turns it off, which leaves a renderer exploit one step from the container.
# CHROMIUM_SANDBOX=1
# A launcher to run in place of Playwright's Chromium; the Docker image sets its own (Chromium as a separate user).
# CHROMIUM_EXECUTABLE=
# The native render server (the Unity player on the CPU, no browser) in place of Chromium: its entrypoint, the build it
# is (release and sha256, part of every capture's identity) and a folder both users can reach. The Docker image sets all three.
# RENDER_SERVER=
# RENDER_SERVER_BUILD=
# RENDER_SERVER_WORK_DIR=
# 0 skips the startup self-test (browser + WebGPU device, and the Decentraland hosts a render needs).
# RENDERER_SELF_TEST=1

# Chromium's profile between runs (compiled WASM, shaders, the avatar the previewer downloads): most of a cold
# start. Empty disables it; ignored when MAX_CONCURRENT_RUNS is above 1, since Chromium locks one profile at a time.
# CHROMIUM_PROFILE_DIR=<tmp>/wearable-validator-chromium

# Render timeouts in ms, overriding the manifest (15000 per previewer command, 180000 for the previewer to load,
# 360000 for one capture batch). Raise them on a host with few vCPUs: software rendering there is many times slower.
# RENDER_COMMAND_TIMEOUT_MS=
# RENDER_LOAD_TIMEOUT_MS=
# RENDER_TOTAL_TIMEOUT_MS=
# The catalyst a run started from a shop URL or URN fetches the published item from (no trailing slash).
# CATALYST_URL=https://peer.decentraland.org
# The whole fetch (lookup and every file) must finish within this many milliseconds; past it the run ends with a retry hint.
# CATALYST_TIMEOUT_MS=60000
# Where run folders are written; defaults to packages/server/artifacts.
# ARTIFACTS_DIR=
# The built website to serve at /; defaults to packages/web/dist.
# SITE_DIR=

# Renders at once: one per ~2 GB of RAM. Everyone else waits in the line the site shows.
MAX_CONCURRENT_RUNS=1
# Largest upload accepted (bytes): 32 MB. The rule book allows larger items, but nothing is buffered beyond this per request.
MAX_UPLOAD_BYTES=33554432
# A request (headers and body) must arrive within this many milliseconds.
UPLOAD_TIMEOUT_MS=60000
# Runs one owner may have waiting or rendering at once; the next upload answers 429.
MAX_ACTIVE_RUNS_PER_OWNER=3
# Runs the line holds; beyond it uploads answer 503 until a slot frees.
MAX_WAITING_RUNS=20
# Runs that reached the renderer in the last 24 hours per owner; the next upload answers 429 saying when a slot opens.
MAX_RUNS_PER_OWNER_PER_DAY=40
# Tabs that may follow one run's event stream at once; the next answers 429.
MAX_SSE_LISTENERS_PER_RUN=5

# json for one JSON line per event (the image sets it); anything else prints readable lines.
# LOG_FORMAT=json

# Prometheus text at GET /metrics (on the server itself, outside the Host and sign-in checks). Unset, it answers anyone
# on loopback and is left off on any other host.
# WKC_METRICS_BEARER_TOKEN=
# WKC_METRICS_PUBLIC_PATH=/metrics
