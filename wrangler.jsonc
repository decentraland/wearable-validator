// Cloudflare Workers Builds config: the validator website at wearable-validator.dclregenesislabs.xyz, behind Cloudflare Access,
// with /api/* forwarded to the run server by packages/web/worker.ts.
// Dashboard build command: "npm ci && npm run build -w wearable-validator-web"; deploy command: "npx wrangler deploy".
// wrangler is an exact-pinned root devDependency so that deploy uses the lockfile copy: an ad-hoc npx download of a
// just-published release once arrived broken ("SyntaxError: Invalid Unicode escape sequence") and failed the deploy.
{
  "name": "wearable-validator",
  "main": "packages/web/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "API_ORIGIN": "https://wearable-validator.decentraland.zone" }
}
